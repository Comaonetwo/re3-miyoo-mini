set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
if(NOT DEFINED ENV{MIYOO_TOOLCHAIN})
  message(FATAL_ERROR "Set MIYOO_TOOLCHAIN to the mini directory (usually /opt/mini)")
endif()
set(MIYOO_TOOLCHAIN "$ENV{MIYOO_TOOLCHAIN}")
set(CMAKE_C_COMPILER "${MIYOO_TOOLCHAIN}/bin/arm-linux-gnueabihf-gcc")
set(CMAKE_CXX_COMPILER "${MIYOO_TOOLCHAIN}/bin/arm-linux-gnueabihf-g++")
execute_process(COMMAND "${CMAKE_C_COMPILER}" -print-sysroot
  OUTPUT_VARIABLE MIYOO_SYSROOT OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE RESULT)
if(NOT RESULT EQUAL 0 OR NOT IS_DIRECTORY "${MIYOO_SYSROOT}")
  message(FATAL_ERROR "Miyoo compiler/sysroot unavailable; run inside Linux/Docker")
endif()
set(CMAKE_SYSROOT "${MIYOO_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${MIYOO_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_C_FLAGS_INIT "-march=armv7-a -mtune=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
